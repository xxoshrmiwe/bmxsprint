---
import '../styles/global.css';
import IdeaFlotante from '../components/IdeaFlotante';

interface Props {
  title?: string;
  noindex?: boolean;
}

const { title = 'GATERIGHT BMX', noindex = false } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="GATERIGHT BMX" />

    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <script is:inline>
      window.deferredInstallPrompt = null;
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        window.deferredInstallPrompt = e;
        window.dispatchEvent(new CustomEvent('pwa-installable'));
      });
    </script>
  </head>
  <body class="min-h-full bg-background pwa-safe-area flex flex-col justify-between">
    <div class="flex-1">
      <slot />
    </div>
    <IdeaFlotante client:only="react" />

    <footer class="py-4 text-center select-none">
      <button
        id="btn-version-pwa"
        type="button"
        title="Toca para verificar actualización de versión"
        class="cursor-pointer rounded-full bg-slate-100 border border-slate-200/80 px-3 py-1 text-[11px] font-bold text-slate-500 hover:bg-slate-200 hover:text-slate-700 transition-all shadow-2xs active:scale-95"
      >
        v1.6.0 · GATERIGHT BMX <span class="opacity-65 font-normal">(Toca para actualizar)</span>
      </button>
    </footer>

    <script is:inline>
      document.getElementById('btn-version-pwa')?.addEventListener('click', () => {
        if ('serviceWorker' in navigator) {
          navigator.serviceWorker.getRegistrations().then((regs) => {
            for (let reg of regs) {
              reg.update();
            }
          });
        }
        window.location.reload();
      });

      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').then((registration) => {
            // Forzar comprobación de versión en cada apertura de la app
            registration.update();
          }).catch((err) => {
            console.error('Error al registrar Service Worker PWA:', err);
          });

          // Si el Service Worker cambia de versión, recargar silenciosamente para refrescar componentes
          let refreshing = false;
          navigator.serviceWorker.addEventListener('controllerchange', () => {
            if (!refreshing) {
              refreshing = true;
              window.location.reload();
            }
          });
        });
      }
    </script>
  </body>
</html>
